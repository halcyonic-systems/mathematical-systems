@prefix atlas: <https://w3id.org/mathematical-systems/atlas/> .
@prefix author: <https://w3id.org/mathematical-systems/atlas/author/> .
@prefix bearer: <https://w3id.org/mathematical-systems/atlas/bearer/> .
@prefix case: <https://w3id.org/mathematical-systems/atlas/case/> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix claim: <https://w3id.org/mathematical-systems/atlas/claim/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix entry: <https://w3id.org/mathematical-systems/atlas/entry/> .
@prefix obj: <https://w3id.org/mathematical-systems/atlas/object/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prim: <https://w3id.org/mathematical-systems/atlas/primitive/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix role: <https://w3id.org/mathematical-systems/atlas/role/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix stance: <https://w3id.org/mathematical-systems/atlas/stance/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

atlas:MDU a atlas:EvidenceCode ;
    rdfs:label "model-drafted, unchecked"@en ;
    skos:definition "A model produced the encoding and no human has checked it. MUST NOT be cited in any claim. Present so that coverage figures stay honest."@en .

atlas:PROP a atlas:EvidenceCode ;
    rdfs:label "propagated from another entry"@en ;
    skos:definition "Asserted because a cited source restates another entry's definition. Inherits the strength of its source, never exceeds it."@en .

atlas:admits a owl:ObjectProperty ;
    rdfs:label "admits"@en ;
    rdfs:domain atlas:FormalSystemDefinition ;
    rdfs:range atlas:Example ;
    skos:definition "Relates a definition to a case its author offers as a system."@en .

atlas:arguedIn a owl:AnnotationProperty ;
    rdfs:label "argued in"@en ;
    skos:definition "Where the claim carried by this term is argued — normally a document in mappings/, which owes a witness and must name its presentation."@en .

atlas:atlas-core rdfs:label "Definition Atlas — Core"@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment """Scaffold for a catalogue of formal mathematical definitions of "system".

WHAT THIS ONTOLOGY ASSERTS: that certain DEFINITIONS exist, are borne by certain
documents, and invoke certain terms.

WHAT IT DOES NOT ASSERT: that the systems those definitions purport to define
exist. CCO's `is about` (cco:ont00001808) is deliberately left unasserted on
entries. This keeps the catalogue neutral between realist traditions (Bunge) and
constructivist ones (Klir), which is the whole point of the exercise: a merged or
realism-committed vocabulary would erase the very disagreements being catalogued.

WHY CCO: a definition is a generically dependent continuant that is about
something — exactly what BFO's GDC category and CCO's Information Content Entity
were introduced for. Alignment is therefore at the ANNOTATION layer only. The
per-tradition vocabularies (Klir's, Bunge's, Mobus's...) are the CONTENT of these
ICEs and are NOT re-parented as BFO domain ontologies.

TIER: this file supports tier 0 (bibliographic + verbatim + primitives invoked).
Tier 1 (dependency quiver) and above are not yet modelled here.

Spec: strategy/phd/definition-atlas-spec.md in the Halcyonic vault."""@en ;
    owl:versionIRI <https://w3id.org/mathematical-systems/atlas/2026-08-01/atlas-core> .

atlas:authorCaveat a owl:AnnotationProperty ;
    rdfs:label "author caveat"@en ;
    skos:definition "A qualification the AUTHOR places on their own definition — that it is provisional, not a definition proper, too general, or holds only under stated conditions. Recorded verbatim. Suppressing these is how a catalogue starts misrepresenting its sources."@en .

atlas:authoredBy a owl:ObjectProperty ;
    rdfs:label "authored by"@en ;
    rdfs:domain cco:ont00000253 ;
    rdfs:range atlas:Author ;
    skos:definition "Relates a bearer to its author. The bearer's dcterms:creator literal stays as the bibliographic string; this property is what makes the attribution a node two works can share."@en .

case:bunge-molecule-reef-family-factory a atlas:RetiredTerm ;
    dcterms:isReplacedBy case:bunge-factory,
        case:bunge-family,
        case:bunge-molecule,
        case:bunge-reef ;
    rdfs:comment """Retired 2026-08-05: four cases were encoded as one individual, which blocked
each from ever being matched against another author's ruling on the same object. Split under
the P4 sign-off; first precedent under the D5 retirement policy (docs/iri-policy.md)."""@en ;
    owl:deprecated true .

claim:bunge-ces-no-faithful-embedding-into-klir a atlas:MappingClaim ;
    rdfs:comment """The collapse witness: σ₁ = ⟨{a,b,c}, ∅, S⟩ and σ₂ = ⟨{a,b}, {c}, S⟩ are
distinct systems by entry 002 and flatten to the single Klir pair ({a,b,c}, S). The datum
erased is the C/E partition — the environment channel of mapping 003.

NO atlas:theoremName YET, and its absence is a debt, not a licence: the Lean declaration
(the forgetful map from the Bunge shape is not injective, witnessed by σ₁, σ₂) is owed to
systems-science-foundations, and the P2 test object that would let the build derive the
collapse is owed to this catalogue. Until one lands, this claim is asserted."""@en ;
    atlas:arguedIn "mappings/environment-channel.md" ;
    atlas:claimRelation atlas:no-faithful-embedding-into ;
    atlas:claimSource entry:bunge-1979-ces-triple ;
    atlas:claimTarget entry:klir-2001-eq-1-1 ;
    atlas:encodedBy "Shingai Thornton (Claude-drafted from mapping 003, claim b)" ;
    atlas:encodedOn "2026-08-07"^^xsd:date ;
    atlas:evidenceCode atlas:MDHC .

claim:klir-weakly-encompasses-bunge-ces a atlas:MappingClaim ;
    rdfs:comment """The redescription: T := C ∪ E, R := S — Bunge's own formulation already
says S is a set of relations on C ∪ E. What the redescription is permitted to discard is
exactly what distinguishes Bunge: the C/E partition, disjointness, bonding, the time index.
The flattening this claim asserts is the same one whose loss claim:bunge-ces-no-faithful-embedding-into-klir
records — the two are one finding read from its two sides."""@en ;
    atlas:arguedIn "mappings/klir-encompassing.md" ;
    atlas:claimRelation atlas:weakly-encompasses ;
    atlas:claimSource entry:klir-2001-eq-1-1 ;
    atlas:claimTarget entry:bunge-1979-ces-triple ;
    atlas:encodedBy "Shingai Thornton (Claude-drafted from mapping 001, Test 1)" ;
    atlas:encodedOn "2026-08-07"^^xsd:date ;
    atlas:evidenceCode atlas:MDHC .

claim:klir-weakly-encompasses-bunge-def-1-1 a atlas:MappingClaim ;
    rdfs:comment """The redescription: T := the connected things, R := the connection
relation. What it discards is that the relation must be a CONNECTION — the bonding requirement
that does Bunge's refusing (see obj:ordered-non-bonding)."""@en ;
    atlas:arguedIn "mappings/klir-encompassing.md" ;
    atlas:claimRelation atlas:weakly-encompasses ;
    atlas:claimSource entry:klir-2001-eq-1-1 ;
    atlas:claimTarget entry:bunge-1979-def-1-1 ;
    atlas:encodedBy "Shingai Thornton (Claude-drafted from mapping 001, Test 1)" ;
    atlas:encodedOn "2026-08-07"^^xsd:date ;
    atlas:evidenceCode atlas:MDHC .

atlas:claimRelation a owl:ObjectProperty ;
    rdfs:label "claim relation"@en ;
    skos:definition "Which relation from the relation scheme this claim asserts between its source and target."@en .

atlas:claimSource a owl:ObjectProperty ;
    rdfs:label "claim source"@en ;
    skos:definition "The entry the relation runs from."@en .

atlas:claimTarget a owl:ObjectProperty ;
    rdfs:label "claim target"@en ;
    skos:definition "The entry the relation runs to."@en .

atlas:definition-atlas a owl:Ontology .

atlas:displayContext a owl:AnnotationProperty ;
    rdfs:label "display context"@en ;
    skos:definition """The span of the verbatim that is the author's own plain-language reading
of the display form — Klir's "where S, T, R denote…", Bunge's disjointness clause. Same contract
as atlas:displayForm: an exact substring of atlas:verbatim, enforced by the build. Together the
two spans let an interface lead with the mathematics and follow with the author's gloss without
one editorial word being added."""@en .

atlas:displayForm a owl:AnnotationProperty ;
    rdfs:label "display form"@en ;
    skos:definition """The span of the verbatim that is the definition's formal statement — the
face a reader meets first, e.g. `S = (T, R)` or `σ = ⟨C, E, S⟩`. Presentation only: it adds no
content, it marks a span. MUST be an exact substring of atlas:verbatim on the same individual —
the build refuses an entry where it is not, so this property can never put words in an author's
mouth. Absent where the definition has no formal statement to lift; the verbatim then faces
whole."""@en .

atlas:encodedBy a owl:AnnotationProperty ;
    rdfs:label "encoded by"@en .

atlas:encodedOn a owl:AnnotationProperty ;
    rdfs:label "encoded on"@en .

<https://w3id.org/mathematical-systems/atlas/entries/bertalanffy-1968-gst> rdfs:label "Atlas entry — Bertalanffy 1968, General System Theory"@en ;
    rdfs:comment """Entry 005. The canonical book, entered after the 1972 article (entry 004)
rather than before it, because the only held copy is an OCR in which eq. (3.1) did not survive
— the equation below was transcribed from the page image and screenshot-verified on 2026-08-05.
The 1968/1972 pair makes the revision citable: what changed between them is proved in Lean
(bert68To72Pre, environment_is_new), not narrated."""@en .

<https://w3id.org/mathematical-systems/atlas/entries/bertalanffy-1972-history-status> rdfs:label "Atlas entry — Bertalanffy 1972, The History and Status of General Systems Theory"@en ;
    rdfs:comment """Entry 004. The founder of the tradition, entered from a journal article rather
than the 1968 book — the first non-book bearer in the catalogue. The reason is transcription
discipline, recorded in the entry's apparatus."""@en .

<https://w3id.org/mathematical-systems/atlas/entries/bunge-1979-treatise> rdfs:label "Atlas entries — Bunge 1979, Treatise on Basic Philosophy vol. 4"@en ;
    rdfs:comment """Entries 002 and 003.

TWO entries from one source, deliberately. Bunge gives a general CHARACTERISATION
of system as an ordered triple, then explicitly says it is "not a definition
proper" and supplies a separate DEFINITION of concrete system. Collapsing them
into one entry would misrepresent him and would erase the caveat he himself
insisted on. The distinction is his, not ours."""@en .

<https://w3id.org/mathematical-systems/atlas/entries/klir-2001-facets> rdfs:label "Atlas entry — Klir 2001, Facets of Systems Science"@en ;
    rdfs:comment "Entry 001. The first entry in the catalogue, and the tradition the deck opens with."@en .

<https://w3id.org/mathematical-systems/atlas/entries/mesarovic-takahara-1975-gst> rdfs:label "Atlas entry — Mesarović & Takahara (1975), General Systems Theory: Mathematical Foundations, Ch. II §1(a), Definition 1.1 (book p. 11)"@en ;
    rdfs:comment """Drafted 2026-08-25 by the P5 pipeline; accessioned at MDU 2026-08-26;
promoted to MDHC the same day after the verbatim was read against the page image (scan
p. 22 = book p. 11) by Shingai Thornton — see the TRANSCRIPTION block for what was checked,
including the braces defect the review caught. Still open from the guided pass: candidate 0
(the Ch. I p. 6 characterisation — distinct entry per the Bunge two-entry precedent, or a
preview of Def 1.1), the four minted primitives' roles and possible merges (their scope
notes still carry MDU markers), and joint-authorship modelling (no Takahara node yet)."""@en .

<https://w3id.org/mathematical-systems/atlas/entries/mobus-2022-tamd> rdfs:label "Atlas entry — Mobus 2022, Systems Science: Theory, Analysis, Modeling, and Design"@en ;
    rdfs:comment """Entry 006. The first entry drafted by the P5 ingest pipeline (2026-08-17)
and promoted through a guided human pass (2026-08-18) — verbatim, spans, caveats, location,
primitives and cases each ruled on individually. The published definition is a SEVEN-tuple
with no environment element; the eighth element arrives in the revisions manuscript
(bearer registered as mobus-book-revisions, entry to come), which is why this bearer and
that one stay distinct: the revision arc is the finding, as with Bertalanffy 1968/1972."""@en .

<https://w3id.org/mathematical-systems/atlas/entries/mobus-book-revisions> rdfs:label "Atlas entry — Mobus, revisions manuscript (March 2025)"@en ;
    rdfs:comment """Entry 007. The second half of the Mobus revision arc: the published
seven-tuple (entry 006) revised to an oct-tuple with the environment E first-class. Second
entry through the P5 pipeline, promoted by guided pass 2026-08-18. The manuscript also
REPRODUCES the original Eq. 4.1 before revising it — the scan graded that reproduction PROP
(a restatement of entry 006), which is why it is not a third entry."""@en .

entry:bertalanffy-1968-eq-3-1 a atlas:FormalSystemDefinition ;
    rdfs:label "Bertalanffy (1968), General System Theory, eq. (3.1)"@en ;
    rdfs:comment """HVP, AND THE SCOPE OF THE CHECK IS EXACTLY THIS: Shingai read the page on
2026-08-05 — the prose against this transcription, and the equation against the page image,
because no text layer in any held source contains eq. (3.1) at all. The equation here is
transcribed from that image, screenshot-verified the same day. The held Kindle text renders
subscript i as t ("pt", "Qt") — an artifact of the rendering, not the book; the subscripts
above are as printed. Page numbering is Kindle print-equivalent pagination, corroborated by
the print index's "mathematical definition, 56-60".

THE HEDGE IS PART OF THE RECORD. The verbatim opens at "A system can be defined mathematically
in various ways" rather than at the equation: 1968 offers the differential equations as one
illustration among various possible formalisations, and cutting the hedge would harden an
avowedly illustrative choice into a definition the author did not state that way. The 1972
restatement (entry 004) carries the same hedge in the other direction — a verbal definition
pointing at unspecified mathematics.

WHAT THE REVISION CHANGED, NOW CITABLE FROM BOTH ENDS. 1968: elements and their interrelation,
no environment term — the shape has two positions and one arrow, and is proved isomorphic to
Klir's. 1972: "and with the environment" — a third position and a second arrow. The difference
is machine-checked: bert68To72Pre embeds the 1968 shape in the 1972 one (bert68To72_obj_injective),
and environment_is_new proves the environment position is not in its image. This entry is the
1968 end of that pair; mapping 003 (environment-channel.md) is where the finding is stated.

WHY THE 1972 ARTICLE WAS ENTERED FIRST: transcription discipline. See entry 004's apparatus;
this entry existing at all is the "second entry from the same tradition" that apparatus
promised.""" ;
    atlas:admits case:bertalanffy-organism ;
    atlas:authorCaveat "A system can be defined mathematically in various ways." ;
    atlas:displayContext "For illustration, we choose a system of simultaneous differential equations." ;
    atlas:displayForm """dQ₁/dt = f₁(Q₁, Q₂, … Qₙ)
dQ₂/dt = f₂(Q₁, Q₂, … Qₙ)
⋯
dQₙ/dt = fₙ(Q₁, Q₂, … Qₙ)""" ;
    atlas:encodedBy "Shingai Thornton (Claude-assisted)" ;
    atlas:encodedOn "2026-08-07"^^xsd:date ;
    atlas:evidenceCode atlas:HVP ;
    atlas:floorDependencyShapeLevel true ;
    atlas:floorPosition prim:element ;
    atlas:formalisedAs "Systems/Category/ShapeBertalanffy.lean#BertalanffyShape" ;
    atlas:hasStance stance:bertalanffy-1968-ontic ;
    atlas:invokesPrimitive prim:element,
        prim:measure,
        prim:time ;
    atlas:sourceLocation "ch. 3, eq. (3.1), p. 56" ;
    atlas:statedIn bearer:bertalanffy-1968-gst ;
    atlas:verbatim """A system can be defined mathematically in various ways. For illustration, we choose a system of simultaneous differential equations. Denoting some measure of elements, pᵢ (i = 1, 2, … n), by Qᵢ, these, for a finite number of elements and in the simplest case, will be of the form:

dQ₁/dt = f₁(Q₁, Q₂, … Qₙ)
dQ₂/dt = f₂(Q₁, Q₂, … Qₙ)
⋯
dQₙ/dt = fₙ(Q₁, Q₂, … Qₙ)                                    (3.1)""" .

entry:bertalanffy-1972-set-in-interrelation a atlas:FormalSystemDefinition ;
    rdfs:label "Bertalanffy (1972), The History and Status of General Systems Theory, p. 417"@en ;
    rdfs:comment """HVP: the page was read against this transcription on 2026-08-05, including
the two things a paraphrase would smooth away — that it prints "may be defined" rather than
"can be", and that "and with the environment" is really there. The second is the clause that
distinguishes this definition from the 1968 book's, so the whole entry turns on it.

WHY THE 1972 ARTICLE AND NOT THE 1968 BOOK. The book is the canonical
citation, and its ch. 3 (p. 55) gives the same definition verbally — "a complex of interacting
elements" — followed by the differential-equation formalisation, eq. (3.1). The only copy of
the book available to this encoding is an OCR whose ligatures are systematically damaged and
in which **equation (3.1) did not survive at all**. Transcribing a verbatim from it would
violate the catalogue's first discipline. The 1972 article restates the definition in a text
with clean provenance, so it is entered first. The 1968 entry remains wanted, and the pair is
worth having: the definitions differ.

WHAT THE REVISION CHANGED. 1968: "a complex of interacting elements." 1972: "a set of elements
standing in interrelation among themselves AND WITH THE ENVIRONMENT." The environment becomes
constitutive of the definition rather than a later distinction. Encoding both would make that
revision machine-checkable at the shape level — the 1972 shape carries an arrow the 1968 shape
does not.

WHAT IS DELIBERATELY OUT OF THE VERBATIM. The differential-equation material sits on the
following page (p. 418, "a set of n measures, called state variables... a set of n
simultaneous, first-order differential equations"), and its equation is a page image in this
scan, not extractable text. Including that sentence would end the verbatim on a colon pointing
at something the catalogue does not hold. It is a candidate for a second entry from the same
bearer, in the way Bunge's CES triple and Definition 1.1 are two entries from one book.

THE AUTHOR'S OWN HEDGE is inside the verbatim, not paraphrased around it: "This can be
expressed mathematically in different ways." On the same page he names Mesarović, Maccia,
Ashby and Klir as fellow axiomatisers — the founder pointing at two other entries in this
catalogue.""" ;
    atlas:authorCaveat "This can be expressed mathematically in different ways." ;
    atlas:displayContext "This can be expressed mathematically in different ways." ;
    atlas:displayForm "A system may be defined as a set of elements standing in interrelation among themselves and with the environment." ;
    atlas:encodedBy "Shingai Thornton (Claude-assisted)" ;
    atlas:encodedOn "2026-08-05"^^xsd:date ;
    atlas:evidenceCode atlas:HVP ;
    atlas:floorDependency prim:relation ;
    atlas:floorPosition prim:element ;
    atlas:formalisedAs "Systems/Category/ShapeBertalanffy.lean#Bertalanffy72Shape" ;
    atlas:invokesPrimitive prim:element,
        prim:environment,
        prim:relation,
        prim:set ;
    atlas:sourceLocation "p. 417" ;
    atlas:statedIn bearer:bertalanffy-1972-amj ;
    atlas:verbatim "A system may be defined as a set of elements standing in interrelation among themselves and with the environment. This can be expressed mathematically in different ways." .

entry:mesarovic-takahara-1975-general-system a atlas:FormalSystemDefinition ;
    rdfs:label "Mesarović & Takahara (1975), General Systems Theory: Mathematical Foundations, Ch. II §1(a), Definition 1.1 (book p. 11)"@en ;
    rdfs:comment """SCOPE OF THE ENTRY. The entry carries Definition 1.1 alone — the set-theoretic definition of a (general) system as a relation on nonempty abstract sets — together with the author's immediate gloss naming × as Cartesian product, I as the index set, and a component set Vᵢ as a system object, plus the finite-index form (2.2). Definitions 1.2 (input object, output object, input-output system), 1.3 (function-type system), and the parallel presentation at book p. 6 (eq. 1.1) are not encoded here.

TRANSCRIPTION. The source file warns that its OCR mangles notation; the verbatim follows the page-image transcription supplied with the source (scan page 22 = book page 11; made 2026-08-25 by a model reading the page image). Verified against the page image by Shingai Thornton, 2026-08-26: ⊂ (proper subset, not ⊆) confirmed in (2.1) and (2.2); "nonempty" confirmed; the gloss sentence confirmed; equation numbers confirmed as printed — and the reviewer caught that (2.1) prints set-builder braces, ×{Vᵢ : i ∈ I}, which the draft had dropped to satisfy the locator. The locator now normalises braces on both sides (reported as a normalisation), and the verbatim carries the braces the page prints. Subscripts are carried as the source file writes them.

DELIBERATELY NOT ASSERTED. No cco is-about relation is asserted between this entry and any subject matter, thing, or phenomenon. The catalogue records that this author, in this locus, uses these words in this formal statement; it does not assert what the definition is about, nor that this 'system' is the same notion as any other author's.

WHAT DOES NOT FIT. The passage rules on no examples: it neither offers a concrete thing as a system nor refuses one, so admits and refuses are empty. No qualification is placed on the definition within the passage, so author_caveat is null; the restriction 'The form (2.3) rather than (2.2) will be used throughout this book' belongs to Definition 1.2's neighbourhood and is not carried here. The primitive slugs 'Cartesian product', 'index set', 'component set', and 'system object' are minted new rather than merged with the existing 'component', 'set', or 'object' slugs, because the words the author uses differ; whether these should be censused together is left open."""@en ;
    atlas:displayContext "where × denotes Cartesian product and I is the index set. A component set Vᵢ is referred to as a system object." ;
    atlas:displayForm """A (general) system is a relation on nonempty (abstract) sets
S ⊂ × {Vᵢ : i ∈ I} (2.1)""" ;
    atlas:encodedBy "claude-opus-5 via atlas/ingest/draft_entry.py; verbatim checked against the page image by Shingai Thornton 2026-08-26" ;
    atlas:encodedOn "2026-08-25"^^xsd:date ;
    atlas:evidenceCode atlas:MDHC ;
    atlas:floorDependency prim:relation ;
    atlas:floorPosition prim:system-object ;
    atlas:invokesPrimitive prim:cartesian-product,
        prim:component-set,
        prim:index-set,
        prim:relation,
        prim:set,
        prim:system-object ;
    atlas:sourceLocation "Chapter II, §1(a), Definition 1.1, book p. 11 = scan page 22; eqs. (2.1)–(2.2)" ;
    atlas:statedIn bearer:mesarovic-takahara-1975-gst ;
    atlas:verbatim """Definition 1.1. A (general) system is a relation on nonempty (abstract) sets
S ⊂ × {Vᵢ : i ∈ I} (2.1)
where × denotes Cartesian product and I is the index set. A component set Vᵢ is referred to as a system object. When I is finite, (2.1) is written in the form
S ⊂ V₁ × ⋯ × Vₙ (2.2)""" .

entry:mobus-2022-seven-tuple a atlas:FormalSystemDefinition ;
    rdfs:label "Mobus (2022), Systems Science: TAMD, eq. (4.1)"@en ;
    rdfs:comment """VERIFIED AS MDHC: model-drafted by the P5 pipeline 2026-08-17, checked by
Shingai Thornton 2026-08-18 in a guided session against the vault digitisation — verbatim,
spans, both caveats and their positions, location, primitives and cases each ruled on. Not
yet read against the printed page; MDHC, not HVP, records exactly that.

DELIBERATELY NOT ASSERTED: cco:ont00001808 (is about). The catalogue records that this
author, at this locus, states this definition in these words; what the definition is about
is not asserted, per the neutrality invariant.

NO ENVIRONMENT ELEMENT. The published tuple has seven coordinates and no E. The revisions
manuscript revises eq. (4.1) to the eight-tuple with environment first-class — the version
the Lean development encodes — and is registered as its own bearer (mobus-book-revisions)
precisely so the revision is citable rather than silently merged. prim:environment is
deliberately NOT invoked here: the row lighting up only at the revisions entry is the census
recording the revision.

PRIMITIVES (ruled 2026-08-18, two layers): from the passage itself, the conservative
Bertalanffy-1968 standard — subsystem, level of organization, hierarchy, system of interest,
plus time admitted notationally via Δt, the exact dQᵢ/dt precedent. From the PARTS-HARVEST
run the same day (the Bunge Definition 1.2 rule in docs/adding-an-entry.md): component,
flow network, bipartite flow graph, boundary, transformation rule, memory and time interval —
the author's own words for the tuple's symbols, each scope note carrying his defining
sentence machine-located in §4.3.3's subsections. Five were model-harvested and checked in
the guided pass; transformation rule and time interval were hand-recovered with narrower
spans after the model's wider ones failed the locate gate (display-math furniture).

CASES: one admit. The steel-plant worked example (§4.5) is HELD, not recorded: the model
proposed it, but its licensing sentence describes the plant without ruling it a system.
It returns if a stronger licensing sentence is found in §4.5. Nothing in the chapter is
refused systemhood.

NEXT TIER: Systems/Category/ShapeMobus.lean encodes the REVISED eight-tuple (Book-revisions
Eq. 1), not this published seven-tuple. The formalisedAs pointer therefore belongs to the
forthcoming revisions entry, and this entry deliberately carries none."""@en ;
    atlas:admits case:mobus-atom ;
    atlas:authorCaveat "The following definition is proposed as a starting point for developing a formal definition of system.",
        "There is a point we need to be clear about. What is being presented here is, itself, a concept about what a system consists of, how it is composed. It is not being represented as the \"general theory of systems,\" though it might be a candidate for that title." ;
    atlas:displayContext "where i and l are indexes. The index i is a subsystem index and the index l is the level of organization in the system-subsystem hierarchy. Both are 0 for the initial system of interest, S₀,₀ is the designated SOI." ;
    atlas:displayForm "Sᵢ, ₗ = C, N, G, B, T, H, Δtᵢ, ₗ" ;
    atlas:encodedBy "claude-opus-5 via atlas/ingest/draft_entry.py; checked by Shingai Thornton (guided pass)" ;
    atlas:encodedOn "2026-08-18"^^xsd:date ;
    atlas:evidenceCode atlas:MDHC ;
    atlas:floorDependency prim:flow-network ;
    atlas:floorPosition prim:component ;
    atlas:invokesPrimitive prim:bipartite-flow-graph,
        prim:boundary,
        prim:component,
        prim:flow-network,
        prim:hierarchy,
        prim:level-of-organization,
        prim:memory,
        prim:subsystem,
        prim:system-of-interest,
        prim:time,
        prim:time-interval,
        prim:transformation-rule ;
    atlas:sourceLocation "ch. 4, §4.3.3, eq. (4.1), p. 191" ;
    atlas:statedIn bearer:mobus-2022-tamd ;
    atlas:verbatim """Deriving a definition of system from the principles and the ontology, a system S is a 7-tuple:
Sᵢ, ₗ = C, N, G, B, T, H, Δtᵢ, ₗ
where i and l are indexes. The index i is a subsystem index and the index l is the level of organization in the system-subsystem hierarchy. Both are 0 for the initial system of interest, S₀,₀ is the designated SOI.""" .

entry:mobus-revisions-oct-tuple a atlas:FormalSystemDefinition ;
    rdfs:label "Mobus (2025), revisions manuscript, eq. (1)"@en ;
    rdfs:comment """VERIFIED AS MDHC: model-drafted by the P5 pipeline and checked by Shingai
Thornton 2026-08-18 in the same guided session as entry 006 — verbatim, spans, primitives,
caveat and date each ruled on. The manuscript date (March 2025) was supplied by Shingai, who
received the document from its author.

DELIBERATELY NOT ASSERTED: cco:ont00001808 (is about), per the neutrality invariant.

THE REVISION IS THE FINDING. Entry 006's tuple has seven coordinates; this one has eight,
and the new coordinate is E — the environment, now carrying the source/sink objects O and
the milieu M. The environment becoming first-class is the same move Bertalanffy made between
1968 and 1972 (environment_is_new in the Lean development), which makes this the catalogue's
second revision arc with the same content. prim:environment lights up on this entry and not
on entry 006 by design: the census row difference IS the record of the revision.

PRIMITIVES (ruled 2026-08-18): the conservative standard, the words of the passage itself —
set, environment, hierarchy, level of organization, object, milieu — plus time notationally
via Δt (the dQᵢ/dt precedent, as on entry 006). "System" is deliberately NOT recorded as a
primitive: it is the definiendum, the term the definition fixes, not an undefined input it
rests on — and a row every entry would trivially share carries no census information.

NO AUTHOR CAVEAT (ruled 2026-08-18): the drafted candidate ("the subscript indexes ... will
be dropped for simplicity") is notational bookkeeping, not a self-qualification. The
manuscript's framing sentence — that the 2022 treatment "ignored a critical aspect of real
systems, namely that they age and change" — qualifies the OLD definition, and belongs to
this arc note rather than to a caveat on the new one.

HELD, NOT ENTERED: the manuscript's lifecycle equations (St+1 = St⟨ΔS⟩ with
ΔS = ⟨ΔC,ΔN,ΔE,ΔG,ΔB,ΔT,ΔH⟩) were scanned as a candidate. They introduce typed components
and fix a transition relation, but they define system CHANGE over an already-given S rather
than the term "system" — held pending a spec §5 ruling. They are the natural formal locus of
the Mobus life-cycle work and the Bunge–Mobus change-convergence thread, and likely enter
through the mapping layer rather than as an entry.

FORMALISATION: MobusShape encodes THIS equation ("Book-revisions Eq. 1" in
Systems/Mobus/Tuple.lean), which is why the pointer sits here and not on entry 006."""@en ;
    atlas:displayContext "S is now given as an oct-tuple with new member E containing the set, O, (standing for \"objects\" in the environment that are sources and sinks in a unified set) and a new object, M, containing the non-point source/sink variables constituting the interacting milieu around the system." ;
    atlas:displayForm "Sᵢ,ₗ=⟨C,N,E,G,B,T,H,Δt⟩ᵢ,ₗ" ;
    atlas:encodedBy "claude-opus-5 via atlas/ingest/draft_entry.py; checked by Shingai Thornton (guided pass)" ;
    atlas:encodedOn "2026-08-18"^^xsd:date ;
    atlas:evidenceCode atlas:MDHC ;
    atlas:floorDependencyShapeLevel true ;
    atlas:floorPosition prim:object ;
    atlas:formalisedAs "Systems/Category/ShapeMobus.lean#MobusShape" ;
    atlas:invokesPrimitive prim:environment,
        prim:hierarchy,
        prim:level-of-organization,
        prim:milieu,
        prim:object,
        prim:set,
        prim:time ;
    atlas:sourceLocation "\"Extending and Modifying the Framework\", eq. (1), revising Eq. 4.1 of the 2022 book" ;
    atlas:statedIn bearer:mobus-book-revisions ;
    atlas:verbatim """Revised Eq. 4.1 is as follows.
Sᵢ,ₗ=⟨C,N,E,G,B,T,H,Δt⟩ᵢ,ₗ (1)
In what follows, the subscript indexes, i, for index number in the set, and l, for level in the complexity/organization hierarchy will be dropped for simplicity.
S is now given as an oct-tuple with new member E containing the set, O, (standing for "objects" in the environment that are sources and sinks in a unified set) and a new object, M, containing the non-point source/sink variables constituting the interacting milieu around the system.""" .

atlas:evidenceCode a owl:AnnotationProperty ;
    rdfs:label "evidence code"@en ;
    skos:definition "Which atlas:EvidenceCode individual applies to this encoding."@en .

atlas:excludedExample a owl:AnnotationProperty ;
    rdfs:label "excluded example"@en ;
    rdfs:comment "DEPRECATED 2026-08-03. Superseded by atlas:refuses onto an atlas:Example. Retained declared so data written against the old shape stays readable."@en ;
    owl:deprecated true ;
    skos:definition "Something the author explicitly says is NOT a system on this definition. The separating-instance data, captured at tier 0: where two definitions disagree about the same object is exactly where the loss catalogue comes from."@en .

atlas:floor atlas:substratePrimitive prim:set .

atlas:formalisedAs a owl:AnnotationProperty ;
    rdfs:label "formalised as"@en ;
    rdfs:comment """BIBLIOGRAPHIC, NOT A FAITHFULNESS CLAIM. This says only that a
formalisation of this definition exists and where to find it. Whether the quiver
is FAITHFUL to the passage -- which position encodes which primitive, which
phrase licenses which arrow, and what the encoding is silent about -- is a
mapping-layer claim and owes evidence like any other. Recording the pointer here
and the judgement there keeps the two from being confused.

DELIBERATELY A STRING, NOT AN IRI. The foundations are a separate repository with
its own release cadence; a resolvable IRI would pin this catalogue to a commit or
a hosting arrangement neither artifact controls. The reader resolves the path
against a configured checkout and fails the build if the declaration is absent."""@en ;
    skos:definition """The shape category in systems-science-foundations that encodes this
definition's dependency structure, as a path relative to that repository plus the
declaration name: `Systems/Category/ShapeKlir.lean#KlirShape`."""@en .

atlas:gloss a owl:AnnotationProperty ;
    rdfs:label "gloss"@en ;
    skos:definition """Our description of a case, in our words. Distinct from atlas:verbatim on
the same individual, which is the author's. An example carries both: what the case is, and the
author's own reason for ruling on it as they did."""@en .

atlas:hasStance a owl:ObjectProperty ;
    rdfs:label "has stance"@en ;
    skos:definition "Links an entry to a stance assertion about it. The assertion is about the entry (the work), never the author."@en .

<https://w3id.org/mathematical-systems/atlas/imports/cco-bfo-reference> rdfs:label "CCO/BFO reference module (minimal extract)"@en ;
    rdfs:comment "Generated by build.py. Only the external terms the Definition Atlas actually uses, plus their named ancestors. Equivalent-class axioms, restrictions and disjointness from the source ontologies are NOT preserved -- this places terms and renders labels, it does not reproduce CCO/BFO semantics. Do not edit by hand."@en .

atlas:includedExample a owl:AnnotationProperty ;
    rdfs:label "included example"@en ;
    rdfs:comment "DEPRECATED 2026-08-03. Superseded by atlas:admits onto an atlas:Example. Retained declared so data written against the old shape stays readable."@en ;
    owl:deprecated true ;
    skos:definition "Something the author explicitly offers as a system on this definition."@en .

atlas:instantiates a owl:ObjectProperty ;
    rdfs:label "instantiates"@en ;
    rdfs:domain atlas:Example ;
    rdfs:range atlas:TestObject ;
    skos:definition """Relates a case to the test object it is a case of. This is what makes a
disagreement derivable: same test object, one definition admitting and another refusing, is a
separating instance the build can find rather than one an encoder has to assert."""@en .

atlas:invokesPrimitive a owl:ObjectProperty ;
    rdfs:label "invokes primitive"@en ;
    rdfs:comment "Range is skos:Concept, not an OWL class, deliberately. A primitive here is a TERM USED IN A DEFINITION, not a kind of thing in the world. SKOS is about concepts; using it avoids smuggling realism into constructivist traditions."@en ;
    rdfs:domain atlas:FormalSystemDefinition ;
    rdfs:range skos:Concept ;
    skos:definition "Relates a definition to a term it uses as a primitive. The census payload: which primitives recur across definitions, and which are unique to one."@en .

<https://w3id.org/mathematical-systems/atlas/mappings/claims> rdfs:label "Atlas mapping claims"@en ;
    rdfs:comment """The RDF layer of the mapping documents — minted 2026-08-07 when the
pattern across mappings 001–003 became clear, per the rule in README.md. Each claim is a
reified relation between two ENTRIES, pointing at the prose document that argues it. The
document remains the argument; the claim is its address in the graph.

WHAT THE GRAPH CANNOT YET HOLD, so coverage stays honest: mapping 001's strong-reading
counterexample (Joslyn ⇸ Klir, the feedback-cycle obstruction) relates a SHAPE to an entry —
Joslyn has no catalogue entry, so the claim stays in prose. Likewise 001's Myers row. Mapping
002's clash is not duplicated here at all: it is already derived in the graph through
admits/refuses on the shared test object, which is the stronger encoding.

MDHC as of 2026-08-08: the encodings were model-drafted on 2026-08-07 and Shingai checked
each claim against its mapping document the next day."""@en .

<https://w3id.org/mathematical-systems/atlas/mappings/floor> rdfs:label "Floor roles — which primitive plays position, which plays dependency"@en ;
    rdfs:comment """The common-core theorem (systems-science-foundations,
docs/reference/common-core-theorem.md; trusted statements in
Systems/Challenge.lean) proves every encoded shape admits the walking
arrow: one position depending on another. That sharing is a SHAPE fact,
not a vocabulary fact — no lexical primitive appears in every entry
(the compare view's own banner). This file records, per entry, which of
ITS OWN primitives plays each floor role. Where a definition's quoted
passage never names the dependency (the dependency lives only in the
formalisation), the entry declares floorDependencyShapeLevel instead of
a primitive, and the build gate requires its Lean bridge to be resolved.
Everything a definition invokes beyond its floor roles and the ambient
substrate is computed by the build as that definition's additions —
never hand-written."""@en .

atlas:refuses a owl:ObjectProperty ;
    rdfs:label "refuses"@en ;
    rdfs:comment """NOT EVERY NEGATIVE IS A REFUSAL. Bunge refuses ontically -- no bonds,
therefore not a system, and no act of description alters it. Klir's "a collection of books is
not a system, only a set" is not a refusal at all: on his criterion an object is a system iff
it CAN BE DESCRIBED as conforming, and a bare collection can be. Recording the second as a
refusal would manufacture a symmetry the authors do not share. See
docs/proposals/P3-stance-axes.md."""@en ;
    rdfs:domain atlas:FormalSystemDefinition ;
    rdfs:range atlas:Example ;
    skos:definition """Relates a definition to a case its author says is NOT a system on it.
The separating-instance data: where two definitions rule differently on the same case is where
the loss catalogue comes from."""@en .

atlas:sourceLocation a owl:AnnotationProperty ;
    rdfs:label "source location"@en ;
    skos:definition "Where in the bearer the verbatim text appears — equation number, page, section."@en .

atlas:stanceValue a owl:ObjectProperty ;
    rdfs:label "stance value"@en ;
    skos:definition "The value a stance assertion assigns, from one of the two stance schemes. The label is a handle; the assertion's verbatim is the evidence."@en .

atlas:statedIn a owl:ObjectProperty ;
    rdfs:label "stated in"@en ;
    rdfs:comment "TODO: align to the inverse of obo:BFO_0000101 (carrier of) once the CCO carrier chain has been read in full. Declared standalone for now rather than asserted wrongly."@en ;
    rdfs:domain atlas:FormalSystemDefinition ;
    rdfs:range cco:ont00000253 ;
    skos:definition "Relates a definition to the document that carries it."@en .

atlas:theoremName a owl:AnnotationProperty ;
    rdfs:label "theorem name"@en ;
    skos:definition "The Lean declaration backing this claim, as file#name. Absence on a claim of loss means the theorem is owed, not that none is needed."@en .

atlas:verbatim a owl:AnnotationProperty ;
    rdfs:label "verbatim"@en ;
    skos:definition "The definition exactly as written in the source, transcribed without paraphrase. The thing every downstream encoding must be checkable against."@en .

obo:BFO_0000001 a owl:Class ;
    rdfs:label "entity"@en ;
    skos:definition "(Elucidation) An entity is anything that exists or has existed or will exist"@en .

obo:BFO_0000004 a owl:Class ;
    rdfs:label "independent continuant"@en ;
    rdfs:subClassOf obo:BFO_0000002 ;
    skos:definition "b is an independent continuant =Def b is a continuant & there is no c such that b specifically depends on c or b generically depends on c"@en .

obo:BFO_0000030 a owl:Class ;
    rdfs:label "object"@en ;
    rdfs:subClassOf obo:BFO_0000040 ;
    skos:definition "(Elucidation) An object is a material entity which manifests causal unity & is of a type instances of which are maximal relative to the sort of causal unity manifested"@en .

obo:BFO_0000031 a owl:Class ;
    rdfs:label "generically dependent continuant"@en ;
    rdfs:subClassOf obo:BFO_0000002 ;
    skos:definition "(Elucidation) A generically dependent continuant is an entity that exists in virtue of the fact that there is at least one of what may be multiple copies which is the content or the pattern that multiple copies would share"@en .

obo:BFO_0000040 a owl:Class ;
    rdfs:label "material entity"@en ;
    rdfs:subClassOf obo:BFO_0000004 ;
    skos:definition "(Elucidation) A material entity is an independent continuant has some portion of matter as continuant part"@en .

atlas:ObserverRoleScheme a skos:ConceptScheme ;
    rdfs:label "The observer's act"@en ;
    skos:definition "What drawing the boundary does, on the entry's own account. NOT a proxy for the ontic axis: Klir's act is constitutive because of his ontology, but Mobus's is selective while his ontology is realist, so the second column cannot be read off the first."@en .

atlas:RetiredTerm a owl:Class ;
    rdfs:label "Retired Term"@en ;
    skos:definition """A tombstone: an IRI this catalogue once served as a live term and will
never serve as one again. IRIs are permanent (w3id) — a term is never deleted and never
silently mutated; it is retired by CHANGING ITS CLASS to this one, so the strict shapes for
live terms keep their teeth and a stale citation still resolves to a signpost. A retired term
carries owl:deprecated true, at least one dcterms:isReplacedBy successor, and a comment saying
why. Policy and procedure: docs/iri-policy.md (D5). The reader's build refuses to serve a
deprecated IRI as live data, and that refusal is gated."""@en .

atlas:TestObjectScheme a skos:ConceptScheme ;
    rdfs:label "Test objects"@en ;
    skos:definition """Objects that definitions of "system" rule on. Deliberately small: a term
is added only when the corpus contains at least two rulings on the same object, because a test
object with one ruling compares nothing and a test object with none is invented."""@en .

