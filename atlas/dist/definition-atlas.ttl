prim:cartesian-product a skos:Concept ;
    skos:broader role:operation ;
    skos:inScheme atlas:PrimitiveScheme ;
    skos:prefLabel "Cartesian product"@en ;
    skos:scopeNote "The operation denoted by × in (2.1) and (2.2), forming the product of the family of sets of which the system is a subset. [MDU — drafted, unchecked; role proposal: operation]"@en .

prim:component-set a skos:Concept ;
    skos:broader role:sort ;
    skos:inScheme atlas:PrimitiveScheme ;
    skos:prefLabel "component set"@en ;
    skos:scopeNote "A member Vᵢ of the indexed family entering the Cartesian product; the author's word for the factors of the product. Distinct from prim:component (Mobus's word) — merging is a census question. [MDU — drafted, unchecked; role proposal: sort]"@en .

prim:composition a skos:Concept ;
    skos:broader role:operation ;
    skos:inScheme atlas:PrimitiveScheme ;
    skos:prefLabel "composition"@en ;
    skos:scopeNote "Bunge's C. The set of a thing's parts, relativised to a class A and a time t."@en .

prim:index-set a skos:Concept ;
    skos:broader role:sort ;
    skos:inScheme atlas:PrimitiveScheme ;
    skos:prefLabel "index set"@en ;
    skos:scopeNote "The set I indexing the family of sets Vᵢ over which the product is taken. [MDU — drafted, unchecked; role proposal: sort]"@en .

prim:measure a skos:Concept ;
    skos:broader role:operation ;
    skos:inScheme atlas:PrimitiveScheme ;
    skos:prefLabel "measure"@en ;
    skos:scopeNote "Bertalanffy's Qᵢ, 'some measure of elements'. The word is his; reading Qᵢ as a state variable is an interpretation and stays out of the scheme."@en .

prim:memory a skos:Concept ;
    skos:broader role:sort ;
