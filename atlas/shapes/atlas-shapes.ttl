@prefix atlas: <https://w3id.org/mathematical-systems/atlas/> .
@prefix cco:   <https://www.commoncoreontologies.org/> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/mathematical-systems/atlas/shapes>
    a owl:Ontology ;
    rdfs:label "Definition Atlas — validation shapes"@en ;
    rdfs:comment """The atlas's refusal conditions.

Until these existed, the disciplines in README.md and docs/adding-an-entry.md were
prose: a malformed entry could be added and nothing would object. A catalogue whose
whole doctrine is that an instrument should be able to refuse could not itself refuse
anything. These shapes are that fix.

Run with `python build.py` — the build fails if any entry violates them."""@en .


##############################################################################
# Entry shape — every FormalSystemDefinition must be checkable by a second reader
##############################################################################

atlas:EntryShape
    a sh:NodeShape ;
    sh:targetClass atlas:FormalSystemDefinition ;
    rdfs:label "Entry well-formedness"@en ;

    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "Every entry needs a human-readable label." ;
    ] ;

    sh:property [
        sh:path atlas:verbatim ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:minLength 20 ;
        sh:message "Every entry needs exactly one verbatim transcription. It is the only thing every downstream encoding is checkable against; without it the entry is an assertion, not a record." ;
    ] ;

    sh:property [
        sh:path atlas:sourceLocation ;
        sh:minCount 1 ;
        sh:message "Every entry needs a source location. 'It's in the book' is not auditable." ;
    ] ;

    sh:property [
        sh:path atlas:statedIn ;
        sh:minCount 1 ;
        sh:class cco:ont00000253 ;
        sh:message "Every entry must point at an Information Bearing Entity (the document carrying it)." ;
    ] ;

    sh:property [
        sh:path atlas:evidenceCode ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( atlas:HVP atlas:MDHC atlas:MDU atlas:PROP ) ;
        sh:message "Every entry needs exactly one evidence code from the controlled set. An unstamped encoding silently reads as verified." ;
    ] ;

    sh:property [
        sh:path atlas:invokesPrimitive ;
        sh:minCount 1 ;
        sh:class skos:Concept ;
        sh:message "Every entry must invoke at least one primitive, and primitives must be skos:Concepts in the scheme." ;
    ] ;

    # ---- THE INVARIANT ----
    sh:property [
        sh:path cco:ont00001808 ;
        sh:maxCount 0 ;
        sh:message "NEUTRALITY INVARIANT: an entry must not assert cco:is_about. CCO's Descriptive ICE is equivalent to (GDC and is_about some Entity), so asserting it directly commits the catalogue to a realist reading of traditions that reject one (Klir). See README. ⚠ If the intensional-targets proposal is adopted, this shape is REPLACED — not deleted — by one requiring is_about to point at a construct-typed target. Do not simply remove it." ;
    ] .


##############################################################################
# Bearer shape
##############################################################################

atlas:BearerShape
    a sh:NodeShape ;
    sh:targetClass cco:ont00000253 ;
    rdfs:label "Bearer well-formedness"@en ;

    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "Every bearer needs a citable label." ;
    ] ;

    sh:property [
        sh:path atlas:authoredBy ;
        sh:minCount 1 ;
        sh:class atlas:Author ;
        sh:message "Every bearer must be attributed to at least one atlas:Author node. The dcterms:creator string is bibliography; the node is what lets two works share an author, which is what a revision arc hangs off. No maxCount: co-authored works are legitimate." ;
    ] .


##############################################################################
# Author shape — identity only, and the identity must be legible
##############################################################################

atlas:AuthorShape
    a sh:NodeShape ;
    sh:targetClass atlas:Author ;
    rdfs:label "Author well-formedness"@en ;

    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Every author needs exactly one name. An author node is identity and nothing else; without a label it is not even that." ;
    ] .


##############################################################################
# Primitive shape — keeps the scheme from silently accumulating orphans
##############################################################################

##############################################################################
# Signature-role shape — the D1 discipline: a typed primitive types into the
# EXTERNAL scheme only. Four roles, fixed prior to the corpus; a primitive that
# fits none stays untyped (that is a verdict the shape permits), but a broader
# link to anything outside the role scheme would be the corpus minting its own
# taxonomy again — the exact circularity D1 closed.
##############################################################################

atlas:PrimitiveRoleShape
    a sh:NodeShape ;
    sh:targetSubjectsOf skos:broader ;
    sh:property [
        sh:path skos:broader ;
        sh:in ( <https://w3id.org/mathematical-systems/atlas/role/sort>
                <https://w3id.org/mathematical-systems/atlas/role/operation>
                <https://w3id.org/mathematical-systems/atlas/role/relation>
                <https://w3id.org/mathematical-systems/atlas/role/constant> ) ;
        sh:maxCount 1 ;
        sh:message "A primitive's signature role must be one of the four external roles (D1), and at most one. A fifth role minted from the corpus reopens the self-confirming census." ;
    ] .


atlas:PrimitiveShape
    a sh:NodeShape ;
    sh:targetObjectsOf atlas:invokesPrimitive ;
    rdfs:label "Primitive well-formedness"@en ;

    sh:property [
        sh:path skos:inScheme ;
        sh:hasValue atlas:PrimitiveScheme ;
        sh:minCount 1 ;
        sh:message "A primitive must be declared in atlas:PrimitiveScheme. Ad-hoc primitives invented at entry-authoring time are how a lexical scheme becomes unauditable." ;
    ] ;

    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:message "Every primitive needs a preferred label." ;
    ] .


##############################################################################
# Example — a case an author rules on. Reified 2026-08-03 (P4).
##############################################################################

atlas:ExampleShape
    a sh:NodeShape ;
    sh:targetClass atlas:Example ;

    sh:property [
        sh:path atlas:gloss ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Every case needs exactly one gloss — what the case is, in our words. Without it a case is an IRI with a grade attached to nothing." ;
    ] ;

    sh:property [
        sh:path atlas:evidenceCode ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( atlas:HVP atlas:MDHC atlas:MDU atlas:PROP ) ;
        sh:message """Every case needs exactly one evidence code. This is the point of reifying
cases at all: an entry-level code cannot say which of a verbatim, five primitives and three
examples a human actually checked.""" ;
    ] ;

    sh:property [
        sh:path atlas:verbatim ;
        sh:maxCount 1 ;
        sh:message """A case may carry at most one verbatim — the author's own words licensing
the ruling. Optional, because not every author gives one: Klir justifies in the same sentence,
Bunge justifies structurally by the definition that follows.""" ;
    ] ;

    sh:property [
        sh:path atlas:sourceLocation ;
        sh:maxCount 1 ;
        sh:message "A case may carry at most one source location, which is its own and need not be the entry's." ;
    ] .


##############################################################################
# Test object — a case named once so two authors can be compared on it.
##############################################################################

atlas:TestObjectShape
    a sh:NodeShape ;
    sh:targetClass atlas:TestObject ;

    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Every test object needs exactly one preferred label." ;
    ] ;

    sh:property [
        sh:path atlas:evidenceCode ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( atlas:HVP atlas:MDHC atlas:MDU atlas:PROP ) ;
        sh:message """Every test object needs exactly one evidence code. Saying two cases are
about the same object is an interpretation of both, and a derived conflict is only as strong as
the identification underneath it.""" ;
    ] ;

    sh:property [
        sh:path atlas:arguedIn ;
        sh:minCount 1 ;
        sh:message """Every test object must say where its identification is argued. An
unargued test object silently manufactures agreements and disagreements.""" ;
    ] .


##############################################################################
# Retired term — a tombstone. Retirement is a class change (D5): the strict
# shapes for live terms keep their teeth, and this shape enforces what a
# tombstone owes instead. Policy: docs/iri-policy.md.
##############################################################################

atlas:RetiredTermShape
    a sh:NodeShape ;
    sh:targetClass atlas:RetiredTerm ;

    sh:property [
        sh:path owl:deprecated ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "A retired term must say so in the vocabulary consumers check: owl:deprecated true." ;
    ] ;

    sh:property [
        sh:path <http://purl.org/dc/terms/isReplacedBy> ;
        sh:minCount 1 ;
        sh:message """A retired term must name at least one successor. A tombstone that points
nowhere strands every citation that resolves to it.""" ;
    ] ;

    sh:property [
        sh:path rdfs:comment ;
        sh:minCount 1 ;
        sh:message "A retired term must say why it was retired and when." ;
    ] .


##############################################################################
# Stance assertion — a reading of what a definition is doing must carry its
# licence. A stance with no verbatim is a label the catalogue made up; a
# stance with no grade is unfalsifiable editorialising in a graph whose whole
# design is that unverified assertions stay visible and filterable.
##############################################################################

atlas:StanceAssertionShape
    a sh:NodeShape ;
    sh:targetClass atlas:StanceAssertion ;

    sh:property [
        sh:path atlas:stanceValue ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Every stance assertion assigns exactly one value on exactly one axis. Two axes means two assertions — collapsing them is the single-spectrum mistake P3 exists to prevent." ;
    ] ;

    sh:property [
        sh:path atlas:verbatim ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:minLength 20 ;
        sh:message "Every stance assertion carries the author's own words licensing it. The label is a handle; the quotation is the evidence. No verbatim, no stance." ;
    ] ;

    sh:property [
        sh:path atlas:sourceLocation ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Every stance verbatim says where it is from, which need not be the entry's own location — Klir's stance passage is §2.3, sixteen pages from eq. (1.1)." ;
    ] ;

    sh:property [
        sh:path atlas:evidenceCode ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( atlas:HVP atlas:MDHC atlas:MDU atlas:PROP ) ;
        sh:message "Every stance assertion carries exactly one evidence code of its own — the point of reifying it (P4): an entry-level code cannot grade a stance reading separately from a transcription." ;
    ] .


##############################################################################
# Mapping claim — a relation between two entries must say which relation,
# between which entries, argued where, on what evidence. An unanchored claim
# would let the graph assert what no document argues.
##############################################################################

atlas:MappingClaimShape
    a sh:NodeShape ;
    sh:targetClass atlas:MappingClaim ;

    sh:property [
        sh:path atlas:claimRelation ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Every mapping claim asserts exactly one relation from the relation scheme." ;
    ] ;

    sh:property [
        sh:path atlas:claimSource ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class atlas:FormalSystemDefinition ;
        sh:message "Every mapping claim runs from exactly one catalogued entry. A claim about a shape or an unencoded tradition stays in prose until its entry exists." ;
    ] ;

    sh:property [
        sh:path atlas:claimTarget ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class atlas:FormalSystemDefinition ;
        sh:message "Every mapping claim runs to exactly one catalogued entry." ;
    ] ;

    sh:property [
        sh:path atlas:arguedIn ;
        sh:minCount 1 ;
        sh:message "Every mapping claim points at the document that argues it. The claim is an address; the document is the argument." ;
    ] ;

    sh:property [
        sh:path atlas:evidenceCode ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( atlas:HVP atlas:MDHC atlas:MDU atlas:PROP ) ;
        sh:message "Every mapping claim carries exactly one evidence code of its own." ;
    ] .
