@prefix atlas: <https://w3id.org/mathematical-systems/atlas/> .
@prefix bearer: <https://w3id.org/mathematical-systems/atlas/bearer/> .
@prefix case: <https://w3id.org/mathematical-systems/atlas/case/> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix entry: <https://w3id.org/mathematical-systems/atlas/entry/> .
@prefix obj: <https://w3id.org/mathematical-systems/atlas/object/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prim: <https://w3id.org/mathematical-systems/atlas/primitive/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

atlas:MDU a atlas:EvidenceCode ;
    rdfs:label "model-drafted, unchecked"@en ;
    skos:definition "A model produced the encoding and no human has checked it. MUST NOT be cited in any claim. Present so that coverage figures stay honest."@en .

atlas:PROP a atlas:EvidenceCode ;
    rdfs:label "propagated from another entry"@en ;
    skos:definition "Asserted because a cited source restates another entry's definition. Inherits the strength of its source, never exceeds it."@en .

atlas:admits a owl:ObjectProperty ;
    rdfs:label "admits"@en ;
    rdfs:domain atlas:FormalSystemDefinition ;
    rdfs:range atlas:Example ;
    skos:definition "Relates a definition to a case its author offers as a system."@en .

atlas:arguedIn a owl:AnnotationProperty ;
    rdfs:label "argued in"@en ;
    skos:definition "Where the claim carried by this term is argued — normally a document in mappings/, which owes a witness and must name its presentation."@en .

atlas:atlas-core rdfs:label "Definition Atlas — Core"@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment """Scaffold for a catalogue of formal mathematical definitions of "system".

WHAT THIS ONTOLOGY ASSERTS: that certain DEFINITIONS exist, are borne by certain
documents, and invoke certain terms.

WHAT IT DOES NOT ASSERT: that the systems those definitions purport to define
exist. CCO's `is about` (cco:ont00001808) is deliberately left unasserted on
entries. This keeps the catalogue neutral between realist traditions (Bunge) and
constructivist ones (Klir), which is the whole point of the exercise: a merged or
realism-committed vocabulary would erase the very disagreements being catalogued.

WHY CCO: a definition is a generically dependent continuant that is about
something — exactly what BFO's GDC category and CCO's Information Content Entity
were introduced for. Alignment is therefore at the ANNOTATION layer only. The
per-tradition vocabularies (Klir's, Bunge's, Mobus's...) are the CONTENT of these
ICEs and are NOT re-parented as BFO domain ontologies.

TIER: this file supports tier 0 (bibliographic + verbatim + primitives invoked).
Tier 1 (dependency quiver) and above are not yet modelled here.

Spec: strategy/phd/definition-atlas-spec.md in the Halcyonic vault."""@en ;
    owl:versionIRI <https://w3id.org/mathematical-systems/atlas/2026-08-01/atlas-core> .

atlas:authorCaveat a owl:AnnotationProperty ;
    rdfs:label "author caveat"@en ;
    skos:definition "A qualification the AUTHOR places on their own definition — that it is provisional, not a definition proper, too general, or holds only under stated conditions. Recorded verbatim. Suppressing these is how a catalogue starts misrepresenting its sources."@en .

case:bunge-molecule-reef-family-factory a atlas:RetiredTerm ;
    dcterms:isReplacedBy case:bunge-factory,
        case:bunge-family,
        case:bunge-molecule,
        case:bunge-reef ;
    rdfs:comment """Retired 2026-08-05: four cases were encoded as one individual, which blocked
each from ever being matched against another author's ruling on the same object. Split under
the P4 sign-off; first precedent under the D5 retirement policy (docs/iri-policy.md)."""@en ;
    owl:deprecated true .

atlas:definition-atlas a owl:Ontology .

atlas:displayContext a owl:AnnotationProperty ;
    rdfs:label "display context"@en ;
    skos:definition """The span of the verbatim that is the author's own plain-language reading
of the display form — Klir's "where S, T, R denote…", Bunge's disjointness clause. Same contract
as atlas:displayForm: an exact substring of atlas:verbatim, enforced by the build. Together the
two spans let an interface lead with the mathematics and follow with the author's gloss without
one editorial word being added."""@en .

atlas:displayForm a owl:AnnotationProperty ;
    rdfs:label "display form"@en ;
    skos:definition """The span of the verbatim that is the definition's formal statement — the
face a reader meets first, e.g. `S = (T, R)` or `σ = ⟨C, E, S⟩`. Presentation only: it adds no
content, it marks a span. MUST be an exact substring of atlas:verbatim on the same individual —
the build refuses an entry where it is not, so this property can never put words in an author's
mouth. Absent where the definition has no formal statement to lift; the verbatim then faces
whole."""@en .

atlas:encodedBy a owl:AnnotationProperty ;
    rdfs:label "encoded by"@en .

atlas:encodedOn a owl:AnnotationProperty ;
    rdfs:label "encoded on"@en .

<https://w3id.org/mathematical-systems/atlas/entries/bertalanffy-1968-gst> rdfs:label "Atlas entry — Bertalanffy 1968, General System Theory"@en ;
    rdfs:comment """Entry 005. The canonical book, entered after the 1972 article (entry 004)
rather than before it, because the only held copy is an OCR in which eq. (3.1) did not survive
— the equation below was transcribed from the page image and screenshot-verified on 2026-08-05.
The 1968/1972 pair makes the revision citable: what changed between them is proved in Lean
(bert68To72Pre, environment_is_new), not narrated."""@en .

<https://w3id.org/mathematical-systems/atlas/entries/bertalanffy-1972-history-status> rdfs:label "Atlas entry — Bertalanffy 1972, The History and Status of General Systems Theory"@en ;
    rdfs:comment """Entry 004. The founder of the tradition, entered from a journal article rather
than the 1968 book — the first non-book bearer in the catalogue. The reason is transcription
discipline, recorded in the entry's apparatus."""@en .

<https://w3id.org/mathematical-systems/atlas/entries/bunge-1979-treatise> rdfs:label "Atlas entries — Bunge 1979, Treatise on Basic Philosophy vol. 4"@en ;
    rdfs:comment """Entries 002 and 003.

TWO entries from one source, deliberately. Bunge gives a general CHARACTERISATION
of system as an ordered triple, then explicitly says it is "not a definition
proper" and supplies a separate DEFINITION of concrete system. Collapsing them
into one entry would misrepresent him and would erase the caveat he himself
insisted on. The distinction is his, not ours."""@en .

<https://w3id.org/mathematical-systems/atlas/entries/klir-2001-facets> rdfs:label "Atlas entry — Klir 2001, Facets of Systems Science"@en ;
    rdfs:comment "Entry 001. The first entry in the catalogue, and the tradition the deck opens with."@en .

entry:bertalanffy-1968-eq-3-1 a atlas:FormalSystemDefinition ;
    rdfs:label "Bertalanffy (1968), General System Theory, eq. (3.1)"@en ;
    rdfs:comment """HVP, AND THE SCOPE OF THE CHECK IS EXACTLY THIS: Shingai read the page on
2026-08-05 — the prose against this transcription, and the equation against the page image,
because no text layer in any held source contains eq. (3.1) at all. The equation here is
transcribed from that image, screenshot-verified the same day. The held Kindle text renders
subscript i as t ("pt", "Qt") — an artifact of the rendering, not the book; the subscripts
above are as printed. Page numbering is Kindle print-equivalent pagination, corroborated by
the print index's "mathematical definition, 56-60".

THE HEDGE IS PART OF THE RECORD. The verbatim opens at "A system can be defined mathematically
in various ways" rather than at the equation: 1968 offers the differential equations as one
illustration among various possible formalisations, and cutting the hedge would harden an
avowedly illustrative choice into a definition the author did not state that way. The 1972
restatement (entry 004) carries the same hedge in the other direction — a verbal definition
pointing at unspecified mathematics.

WHAT THE REVISION CHANGED, NOW CITABLE FROM BOTH ENDS. 1968: elements and their interrelation,
no environment term — the shape has two positions and one arrow, and is proved isomorphic to
Klir's. 1972: "and with the environment" — a third position and a second arrow. The difference
is machine-checked: bert68To72Pre embeds the 1968 shape in the 1972 one (bert68To72_obj_injective),
and environment_is_new proves the environment position is not in its image. This entry is the
1968 end of that pair; mapping 003 (environment-channel.md) is where the finding is stated.

WHY THE 1972 ARTICLE WAS ENTERED FIRST: transcription discipline. See entry 004's apparatus;
this entry existing at all is the "second entry from the same tradition" that apparatus
promised.""" ;
    atlas:admits case:bertalanffy-organism ;
    atlas:authorCaveat "A system can be defined mathematically in various ways." ;
    atlas:displayContext "For illustration, we choose a system of simultaneous differential equations." ;
    atlas:displayForm """dQ₁/dt = f₁(Q₁, Q₂, … Qₙ)
dQ₂/dt = f₂(Q₁, Q₂, … Qₙ)
⋯
dQₙ/dt = fₙ(Q₁, Q₂, … Qₙ)""" ;
    atlas:encodedBy "Shingai Thornton (Claude-assisted)" ;
    atlas:encodedOn "2026-08-07"^^xsd:date ;
    atlas:evidenceCode atlas:HVP ;
    atlas:formalisedAs "Systems/Category/ShapeBertalanffy.lean#BertalanffyShape" ;
    atlas:invokesPrimitive prim:element,
        prim:measure,
        prim:time ;
    atlas:sourceLocation "ch. 3, eq. (3.1), p. 56" ;
    atlas:statedIn bearer:bertalanffy-1968-gst ;
    atlas:verbatim """A system can be defined mathematically in various ways. For illustration, we choose a system of simultaneous differential equations. Denoting some measure of elements, pᵢ (i = 1, 2, … n), by Qᵢ, these, for a finite number of elements and in the simplest case, will be of the form:

dQ₁/dt = f₁(Q₁, Q₂, … Qₙ)
dQ₂/dt = f₂(Q₁, Q₂, … Qₙ)
⋯
dQₙ/dt = fₙ(Q₁, Q₂, … Qₙ)                                    (3.1)""" .

entry:bertalanffy-1972-set-in-interrelation a atlas:FormalSystemDefinition ;
    rdfs:label "Bertalanffy (1972), The History and Status of General Systems Theory, p. 417"@en ;
    rdfs:comment """HVP: the page was read against this transcription on 2026-08-05, including
the two things a paraphrase would smooth away — that it prints "may be defined" rather than
"can be", and that "and with the environment" is really there. The second is the clause that
distinguishes this definition from the 1968 book's, so the whole entry turns on it.

WHY THE 1972 ARTICLE AND NOT THE 1968 BOOK. The book is the canonical
citation, and its ch. 3 (p. 55) gives the same definition verbally — "a complex of interacting
elements" — followed by the differential-equation formalisation, eq. (3.1). The only copy of
the book available to this encoding is an OCR whose ligatures are systematically damaged and
in which **equation (3.1) did not survive at all**. Transcribing a verbatim from it would
violate the catalogue's first discipline. The 1972 article restates the definition in a text
with clean provenance, so it is entered first. The 1968 entry remains wanted, and the pair is
worth having: the definitions differ.

WHAT THE REVISION CHANGED. 1968: "a complex of interacting elements." 1972: "a set of elements
standing in interrelation among themselves AND WITH THE ENVIRONMENT." The environment becomes
constitutive of the definition rather than a later distinction. Encoding both would make that
revision machine-checkable at the shape level — the 1972 shape carries an arrow the 1968 shape
does not.

WHAT IS DELIBERATELY OUT OF THE VERBATIM. The differential-equation material sits on the
following page (p. 418, "a set of n measures, called state variables... a set of n
simultaneous, first-order differential equations"), and its equation is a page image in this
scan, not extractable text. Including that sentence would end the verbatim on a colon pointing
at something the catalogue does not hold. It is a candidate for a second entry from the same
bearer, in the way Bunge's CES triple and Definition 1.1 are two entries from one book.

THE AUTHOR'S OWN HEDGE is inside the verbatim, not paraphrased around it: "This can be
expressed mathematically in different ways." On the same page he names Mesarović, Maccia,
Ashby and Klir as fellow axiomatisers — the founder pointing at two other entries in this
catalogue.""" ;
    atlas:authorCaveat "This can be expressed mathematically in different ways." ;
    atlas:displayContext "This can be expressed mathematically in different ways." ;
    atlas:displayForm "A system may be defined as a set of elements standing in interrelation among themselves and with the environment." ;
    atlas:encodedBy "Shingai Thornton (Claude-assisted)" ;
    atlas:encodedOn "2026-08-05"^^xsd:date ;
    atlas:evidenceCode atlas:HVP ;
    atlas:formalisedAs "Systems/Category/ShapeBertalanffy.lean#Bertalanffy72Shape" ;
    atlas:invokesPrimitive prim:element,
        prim:environment,
        prim:relation,
        prim:set ;
    atlas:sourceLocation "p. 417" ;
    atlas:statedIn bearer:bertalanffy-1972-amj ;
    atlas:verbatim "A system may be defined as a set of elements standing in interrelation among themselves and with the environment. This can be expressed mathematically in different ways." .

entry:bunge-1979-ces-triple a atlas:FormalSystemDefinition ;
    rdfs:label "Bunge (1979), general characterisation: σ = ⟨C, E, S⟩"@en ;
    rdfs:comment """⚑ "is (or represents)". Bunge's own parenthetical hedges between the triple
BEING a system and REPRESENTING one, and he resolves it later in the same chapter
by calling the triple "the minimal model of system σ at time t". This is direct
primary-text evidence on the is-versus-represents question — the distinction the
Lean encodings do not type. Klir's (T,R) IS the system; Bunge's ⟨C,E,S⟩ is a model
OF a thing. Same shape, different ontological status.

⚑ NOT the same triple as the informal gloss. The fuller form Bunge actually works
with is relativised to a class A of things and indexed by time: s_A(σ,t) =
⟨𝒞_A(σ,t), ℰ_A(σ,t), 𝒮_A(σ,t)⟩. Anyone citing "Bunge's CES triple" as a bare
3-tuple is citing the informal version.

⚑ CES, NOT CESM. Mechanism is not a coordinate here. The string "CESM" does not
occur in the 1979 text; mechanism becomes central in later Bunge (see How Does It
Work, 2004). Any citation pairing "1979" with "CESM" is an anachronism.

DELIBERATELY NOT ASSERTED: cco:ont00001808 (is about). Bunge is a realist and
would endorse the reading; asserting it anyway would still break the catalogue's
neutrality, which must not depend on which tradition an entry belongs to."""@en ;
    atlas:admits case:bunge-theory ;
    atlas:authorCaveat "However, the preceding is not a definition proper, because it does not tell us what exactly is the membership of the coordinates C, E and S of the ordered triple. We must therefore define the notions of composition, environment, and structure of a thing." ;
    atlas:displayContext "C and E are mutually disjoint subsets of T (i.e. C ∩ E = ∅), and S is a nonempty set of relations on the union of C and E." ;
    atlas:displayForm "σ = ⟨C, E, S⟩" ;
    atlas:encodedBy "Shingai Thornton (Claude-assisted)" ;
    atlas:encodedOn "2026-08-01"^^xsd:date ;
    atlas:evidenceCode atlas:HVP ;
    atlas:formalisedAs "Systems/Category/ShapeBunge.lean#BungeShape" ;
    atlas:invokesPrimitive prim:composition,
        prim:environment,
        prim:relation,
        prim:set,
        prim:structure,
        prim:thing ;
    atlas:sourceLocation "ch. 1, §1.1 (the general concept of a system)" ;
    atlas:statedIn bearer:bunge-1979-treatise-vol4 ;
    atlas:verbatim "One way of characterizing the general concept of a system is this. Let T be a nonempty set. Then the ordered triple σ = ⟨C, E, S⟩ is (or represents) a system over T iff C and E are mutually disjoint subsets of T (i.e. C ∩ E = ∅), and S is a nonempty set of relations on the union of C and E. The system is conceptual if T is a set of conceptual items, and concrete (or material) if T ⊆ Θ is a set of concrete entities, i.e. things." .

entry:bunge-1979-def-1-1 a atlas:FormalSystemDefinition ;
    rdfs:label "Bunge (1979), Definition 1.1: concrete system"@en ;
    rdfs:comment """⚑ THE SEPARATING INSTANCE, IN BUNGE'S OWN WORDS. His excluded example is
"a collection of events, EVEN IF ORDERED". Klir, on the passage recorded in entry
001, holds that ordering a collection is exactly what makes it a system: "any
ordering of a set is a relation defined on the set". Two founders, both verbatim,
disagreeing about whether an ordered collection is a system. This is the highest-
value datum in the catalogue so far and it was found by reading, not by inference.

MACHINERY BEHIND THE REFUSAL (Definition 1.2, encoded here as primitives rather
than as its own entry, because it defines composition/environment/structure and
not "system"):
  𝒞_A(σ,t) = {x ∈ A | x ⊏ σ}
  ℰ_A(σ,t) = {x ∈ A | x ∉ 𝒞_A(σ,t) & ∃y (y ∈ 𝒞_A(σ,t) & (x ▷ y ∨ y ▷ x))}
  𝒮_A(σ,t) = relations, in particular bonds, on 𝒞_A(σ,t) ∪ ℰ_A(σ,t), with the
             bonding set 𝔅_A(σ,t) ≠ ∅
The nonempty-bonding requirement is what does the refusing, and it is encoded in
systems-science-foundations as ConcreteSystem.bondage_nonempty over the ActsOn
class (Bunge's ▷). The two encodings agree; that agreement should be recorded as
a mapping claim once the mapping layer exists, not asserted here.

RELATION TO ENTRY 002: Bunge presents 002 first and then disowns it as "not a
definition proper". 003 is the definition proper. They are not alternative
phrasings of one claim and must not be merged."""@en ;
    atlas:admits case:bunge-factory,
        case:bunge-family,
        case:bunge-molecule,
        case:bunge-reef ;
    atlas:displayForm "An object is a concrete system iff it is composed of at least two different connected things." ;
    atlas:encodedBy "Shingai Thornton (Claude-assisted)" ;
    atlas:encodedOn "2026-08-01"^^xsd:date ;
    atlas:evidenceCode atlas:HVP ;
    atlas:invokesPrimitive prim:action,
        prim:bond,
        prim:part,
        prim:thing ;
    atlas:refuses case:bunge-events-ordered,
        case:bunge-states-of-a-thing ;
    atlas:sourceLocation "ch. 1, Definition 1.1" ;
    atlas:statedIn bearer:bunge-1979-treatise-vol4 ;
    atlas:verbatim "DEFINITION 1.1 An object is a concrete system iff it is composed of at least two different connected things." .

entry:klir-2001-eq-1-1 a atlas:FormalSystemDefinition ;
    rdfs:label "Klir (2001), Facets of Systems Science, eq. (1.1)"@en ;
    rdfs:comment """VERIFIED: verbatim transcribed from the primary text, not paraphrased.

DELIBERATELY NOT ASSERTED: cco:ont00001808 (is about). Klir is an avowed
constructivist — on his account the relation R is defined by the modeller, not
discovered. Asserting what this definition is *about* would commit the catalogue
to a realist reading Klir does not hold. The neutrality is the point.

EXAMPLES NOTE: Klir gives no excluded example in Bunge's sense. His "a collection
of books is not a system, only a set" (p. 5, same paragraph as the included
examples) is the opening move of an argument whose conclusion is that organising
it *makes* it one, and on his own criterion — an object is a system iff it CAN BE
DESCRIBED in a form conforming to Eq. (1.1) — a bare collection is not refused but
merely not yet distinguished. Recording it as atlas:excludedExample would give it
the same form as Bunge's ontic refusal at Definition 1.1 and manufacture a symmetry
the two authors do not share; in a cases matrix it would read as agreement where
the finding is the opposite. The three included examples are grouped as Klir groups
them: his "etc." marks the variants as instances of a kind, not an enumeration of
cases. Source read 2026-08-03; see docs/proposals/P1-klir-examples.md and
docs/proposals/P3-stance-axes.md.

CENSUS NOTE: Klir's own gloss splits the definition's two slots into named
properties — thinghood in T, systemhood in R. Recorded as separate primitives
rather than folded into `thing` and `relation`, because whether they are distinct
primitives is a question the census should answer, not one the encoding should
prejudge.

ADJACENT MATERIAL, NOT YET ENTERED: Klir's self-assessment on the same page (the
definition is "too general and, consequently, of little pragmatic value" but
"encompasses all other, more specific definitions of systems") is a claim ABOUT
this definition's relation to others. It belongs in the mapping layer, not in
this entry.

NEXT TIER: the dependency quiver (tier 1) for this definition already exists in
Lean as ShapeKlir in systems-science-foundations. The two encodings must be
checked against each other before either is cited."""@en ;
    atlas:admits case:klir-books-ordered,
        case:klir-books-partitioned,
        case:klir-population-by-birth ;
    atlas:displayContext "where S, T, R denote, respectively, a system, a set of things distinguished within S, and a relation (or, possibly, a set of relations) defined on T." ;
    atlas:displayForm "S = (T, R)" ;
    atlas:encodedBy "Shingai Thornton (Claude-assisted)" ;
    atlas:encodedOn "2026-08-01"^^xsd:date ;
    atlas:evidenceCode atlas:HVP ;
    atlas:formalisedAs "Systems/Category/ShapeKlir.lean#KlirShape" ;
    atlas:invokesPrimitive prim:relation,
        prim:set,
        prim:systemhood,
        prim:thing,
        prim:thinghood ;
    atlas:sourceLocation "ch. 1, eq. (1.1), p. 5" ;
    atlas:statedIn bearer:klir-2001-facets ;
    atlas:verbatim """S = (T, R),   (1.1)

where S, T, R denote, respectively, a system, a set of things distinguished within S, and a relation (or, possibly, a set of relations) defined on T. Clearly, the thinghood and systemhood properties of S reside in T and R, respectively.""" .

atlas:evidenceCode a owl:AnnotationProperty ;
    rdfs:label "evidence code"@en ;
    skos:definition "Which atlas:EvidenceCode individual applies to this encoding."@en .

atlas:excludedExample a owl:AnnotationProperty ;
    rdfs:label "excluded example"@en ;
    rdfs:comment "DEPRECATED 2026-08-03. Superseded by atlas:refuses onto an atlas:Example. Retained declared so data written against the old shape stays readable."@en ;
    owl:deprecated true ;
    skos:definition "Something the author explicitly says is NOT a system on this definition. The separating-instance data, captured at tier 0: where two definitions disagree about the same object is exactly where the loss catalogue comes from."@en .

atlas:formalisedAs a owl:AnnotationProperty ;
    rdfs:label "formalised as"@en ;
    rdfs:comment """BIBLIOGRAPHIC, NOT A FAITHFULNESS CLAIM. This says only that a
formalisation of this definition exists and where to find it. Whether the quiver
is FAITHFUL to the passage -- which position encodes which primitive, which
phrase licenses which arrow, and what the encoding is silent about -- is a
mapping-layer claim and owes evidence like any other. Recording the pointer here
and the judgement there keeps the two from being confused.

DELIBERATELY A STRING, NOT AN IRI. The foundations are a separate repository with
its own release cadence; a resolvable IRI would pin this catalogue to a commit or
a hosting arrangement neither artifact controls. The reader resolves the path
against a configured checkout and fails the build if the declaration is absent."""@en ;
    skos:definition """The shape category in systems-science-foundations that encodes this
definition's dependency structure, as a path relative to that repository plus the
declaration name: `Systems/Category/ShapeKlir.lean#KlirShape`."""@en .

atlas:gloss a owl:AnnotationProperty ;
    rdfs:label "gloss"@en ;
    skos:definition """Our description of a case, in our words. Distinct from atlas:verbatim on
the same individual, which is the author's. An example carries both: what the case is, and the
author's own reason for ruling on it as they did."""@en .

<https://w3id.org/mathematical-systems/atlas/imports/cco-bfo-reference> rdfs:label "CCO/BFO reference module (minimal extract)"@en ;
    rdfs:comment "Generated by build.py. Only the external terms the Definition Atlas actually uses, plus their named ancestors. Equivalent-class axioms, restrictions and disjointness from the source ontologies are NOT preserved -- this places terms and renders labels, it does not reproduce CCO/BFO semantics. Do not edit by hand."@en .

atlas:includedExample a owl:AnnotationProperty ;
    rdfs:label "included example"@en ;
    rdfs:comment "DEPRECATED 2026-08-03. Superseded by atlas:admits onto an atlas:Example. Retained declared so data written against the old shape stays readable."@en ;
    owl:deprecated true ;
    skos:definition "Something the author explicitly offers as a system on this definition."@en .

atlas:instantiates a owl:ObjectProperty ;
    rdfs:label "instantiates"@en ;
    rdfs:domain atlas:Example ;
    rdfs:range atlas:TestObject ;
    skos:definition """Relates a case to the test object it is a case of. This is what makes a
disagreement derivable: same test object, one definition admitting and another refusing, is a
separating instance the build can find rather than one an encoder has to assert."""@en .

atlas:invokesPrimitive a owl:ObjectProperty ;
    rdfs:label "invokes primitive"@en ;
    rdfs:comment "Range is skos:Concept, not an OWL class, deliberately. A primitive here is a TERM USED IN A DEFINITION, not a kind of thing in the world. SKOS is about concepts; using it avoids smuggling realism into constructivist traditions."@en ;
    rdfs:domain atlas:FormalSystemDefinition ;
    rdfs:range skos:Concept ;
    skos:definition "Relates a definition to a term it uses as a primitive. The census payload: which primitives recur across definitions, and which are unique to one."@en .

atlas:refuses a owl:ObjectProperty ;
    rdfs:label "refuses"@en ;
    rdfs:comment """NOT EVERY NEGATIVE IS A REFUSAL. Bunge refuses ontically -- no bonds,
therefore not a system, and no act of description alters it. Klir's "a collection of books is
not a system, only a set" is not a refusal at all: on his criterion an object is a system iff
it CAN BE DESCRIBED as conforming, and a bare collection can be. Recording the second as a
refusal would manufacture a symmetry the authors do not share. See
docs/proposals/P3-stance-axes.md."""@en ;
    rdfs:domain atlas:FormalSystemDefinition ;
    rdfs:range atlas:Example ;
    skos:definition """Relates a definition to a case its author says is NOT a system on it.
The separating-instance data: where two definitions rule differently on the same case is where
the loss catalogue comes from."""@en .

atlas:sourceLocation a owl:AnnotationProperty ;
    rdfs:label "source location"@en ;
    skos:definition "Where in the bearer the verbatim text appears — equation number, page, section."@en .

atlas:statedIn a owl:ObjectProperty ;
    rdfs:label "stated in"@en ;
    rdfs:comment "TODO: align to the inverse of obo:BFO_0000101 (carrier of) once the CCO carrier chain has been read in full. Declared standalone for now rather than asserted wrongly."@en ;
    rdfs:domain atlas:FormalSystemDefinition ;
    rdfs:range cco:ont00000253 ;
    skos:definition "Relates a definition to the document that carries it."@en .

atlas:verbatim a owl:AnnotationProperty ;
    rdfs:label "verbatim"@en ;
    skos:definition "The definition exactly as written in the source, transcribed without paraphrase. The thing every downstream encoding must be checkable against."@en .

obo:BFO_0000001 a owl:Class ;
    rdfs:label "entity"@en ;
    skos:definition "(Elucidation) An entity is anything that exists or has existed or will exist"@en .

obo:BFO_0000004 a owl:Class ;
    rdfs:label "independent continuant"@en ;
    rdfs:subClassOf obo:BFO_0000002 ;
    skos:definition "b is an independent continuant =Def b is a continuant & there is no c such that b specifically depends on c or b generically depends on c"@en .

obo:BFO_0000030 a owl:Class ;
    rdfs:label "object"@en ;
    rdfs:subClassOf obo:BFO_0000040 ;
    skos:definition "(Elucidation) An object is a material entity which manifests causal unity & is of a type instances of which are maximal relative to the sort of causal unity manifested"@en .

obo:BFO_0000031 a owl:Class ;
    rdfs:label "generically dependent continuant"@en ;
    rdfs:subClassOf obo:BFO_0000002 ;
    skos:definition "(Elucidation) A generically dependent continuant is an entity that exists in virtue of the fact that there is at least one of what may be multiple copies which is the content or the pattern that multiple copies would share"@en .

obo:BFO_0000040 a owl:Class ;
    rdfs:label "material entity"@en ;
    rdfs:subClassOf obo:BFO_0000004 ;
    skos:definition "(Elucidation) A material entity is an independent continuant has some portion of matter as continuant part"@en .

atlas:MDHC a atlas:EvidenceCode ;
    rdfs:label "model-drafted, human-checked"@en ;
    skos:definition "A model produced the encoding; a human checked it against the verbatim text."@en .

atlas:RetiredTerm a owl:Class ;
    rdfs:label "Retired Term"@en ;
    skos:definition """A tombstone: an IRI this catalogue once served as a live term and will
never serve as one again. IRIs are permanent (w3id) — a term is never deleted and never
silently mutated; it is retired by CHANGING ITS CLASS to this one, so the strict shapes for
live terms keep their teeth and a stale citation still resolves to a signpost. A retired term
carries owl:deprecated true, at least one dcterms:isReplacedBy successor, and a comment saying
why. Policy and procedure: docs/iri-policy.md (D5). The reader's build refuses to serve a
deprecated IRI as live data, and that refusal is gated."""@en .

atlas:TestObjectScheme a skos:ConceptScheme ;
    rdfs:label "Test objects"@en ;
    skos:definition """Objects that definitions of "system" rule on. Deliberately small: a term
is added only when the corpus contains at least two rulings on the same object, because a test
object with one ruling compares nothing and a test object with none is invented."""@en .

bearer:bertalanffy-1968-gst a cco:ont00000253 ;
    rdfs:label "Von Bertalanffy, L. — General System Theory: Foundations, Development, Applications (1968)"@en ;
    dcterms:bibliographicCitation "New York: George Braziller, 1968. Ch. 3, 'Some System Concepts in Elementary Mathematical Consideration', pp. 55–60. Page numbers are Kindle print-equivalent pagination, corroborated against the print index entry 'mathematical definition, 56-60'." ;
    dcterms:creator "Ludwig von Bertalanffy" ;
    dcterms:date "1968"^^xsd:gYear .

bearer:bertalanffy-1972-amj a cco:ont00000253 ;
    rdfs:label "Von Bertalanffy, L. — The History and Status of General Systems Theory, Academy of Management Journal 15(4) (1972)"@en ;
    dcterms:bibliographicCitation "Academy of Management Journal 15(4), December 1972, pp. 407–426. Special issue: General Systems Theory." ;
    dcterms:creator "Ludwig von Bertalanffy" ;
    dcterms:date "1972"^^xsd:gYear ;
    dcterms:identifier "doi:10.2307/255139",
        "https://www.jstor.org/stable/255139" .

bearer:klir-2001-facets a cco:ont00000253 ;
    rdfs:label "Klir, G. J. — Facets of Systems Science, 2nd ed. (Springer, 2001)"@en ;
    dcterms:creator "George J. Klir" ;
    dcterms:date "2001"^^xsd:gYear ;
    dcterms:identifier "ISBN 978-1-4613-5501-4",
        "doi:10.1007/978-1-4615-1331-5" .

case:bertalanffy-organism a atlas:Example ;
    rdfs:label "an organism"@en ;
    rdfs:comment """SAME BEARER AS THE ENTRY, since 2026-08-07. This ruling was first recorded
on entry 004 (the 1972 article) with a DIFFERENT-BEARER caveat, because the catalogue then held
no entry from the 1968 book. It moves here now that it does.

MDHC, AND THE SCOPE OF THE CHECK IS EXACTLY THIS: a human located "Any organism is a system"
on p. 209 of the book on 2026-08-05, so the page and the ruling itself are confirmed. The
remainder of the sentence — "that is, a dynamic order of parts and processes standing in
mutual interaction" — is still as the OCR gives it and has not been read word for word. HVP
needs that last step.

The page number comes from a Kindle edition reporting print-equivalent pagination; the same
edition's p. 56 for eq. (3.1) matches the print index's "mathematical definition, 56-60",
which is the corroboration for trusting its numbering here.

NOT ENCODED AS A REFUSAL: the heap of bricks. Bertalanffy calls heaps the case where a complex
"can be built up, step by step, by putting together the first separate elements" — merely
summative, as against the constitutive characteristics of a Gestalt (1968, ch. 3). That is
architecturally Klir's book-collection and Bunge's ordered-events exclusion, but he never
writes the verdict sentence, and encoding an implication as a ruling would put words in his
mouth. It belongs to the mapping layer.""" ;
    atlas:encodedBy "Shingai Thornton (Claude-assisted)" ;
    atlas:encodedOn "2026-08-05"^^xsd:date ;
    atlas:evidenceCode atlas:MDHC ;
    atlas:gloss "an organism" ;
    atlas:sourceLocation "General System Theory (1968), p. 209, quoting Bertalanffy 1949a p. 11" ;
    atlas:verbatim "Any organism is a system, that is, a dynamic order of parts and processes standing in mutual interaction" .

case:bunge-events-ordered a atlas:Example ;
    rdfs:label "a collection of events, even if ordered"@en ;
    rdfs:comment """Half of the catalogue's first separating instance: Klir admits an ordered
collection, Bunge refuses one. The refusal is ontic — an aggregate is a collection "not held
together by bonds" (p. 4), Definition 1.1 requires the members connected, and Definition
1.2(iii) carries 𝔅≠∅; ordering is not bonding — so he refuses ordered BOOKS for the same
reason. See mappings/ordered-collection.md.

The location was deliberately withheld until human-checked: these cases come from the labelled
Example block that follows Definition 1.1 in §1.2, not from Definition 1.1 itself, so entry
003's location did not cover them. Checked against the source and entered 2026-08-05."""@en ;
    atlas:encodedBy "Shingai Thornton (Claude-assisted)" ;
    atlas:encodedOn "2026-08-01"^^xsd:date ;
    atlas:evidenceCode atlas:HVP ;
    atlas:gloss "a collection of events, even if ordered" ;
    atlas:instantiates obj:ordered-non-bonding ;
    atlas:sourceLocation "ch. 1, §1.2, Example following Definition 1.1, p. 7" .

case:bunge-states-of-a-thing a atlas:Example ;
    rdfs:label "a set of states of a thing"@en ;
    atlas:encodedBy "Shingai Thornton (Claude-assisted)" ;
    atlas:encodedOn "2026-08-01"^^xsd:date ;
    atlas:evidenceCode atlas:HVP ;
    atlas:gloss "a set of states of a thing" ;
    atlas:sourceLocation "ch. 1, §1.2, Example following Definition 1.1, p. 7" .

case:bunge-theory a atlas:Example ;
    rdfs:label "a theory"@en ;
    rdfs:comment "Bunge's own worked conceptual-system example, given inline in §1.1 rather than in a labelled Example block. Location human-checked against the source 2026-08-05."@en ;
    atlas:encodedBy "Shingai Thornton (Claude-assisted)" ;
    atlas:encodedOn "2026-08-01"^^xsd:date ;
    atlas:evidenceCode atlas:HVP ;
    atlas:gloss "a theory: 𝒯 = ⟨P, B, ⊢⟩ — propositions P, embedded in a body of knowledge B, glued by entailment ⊢" ;
    atlas:sourceLocation "ch. 1, §1.1, p. 5" .

case:klir-books-ordered a atlas:Example ;
    rdfs:label "a collection of books, ordered"@en ;
    atlas:encodedBy "Shingai Thornton (Claude-assisted)" ;
    atlas:encodedOn "2026-08-03"^^xsd:date ;
    atlas:evidenceCode atlas:HVP ;
    atlas:gloss "a collection of books ordered by authors' names, publication dates, or size" ;
    atlas:instantiates obj:ordered-non-bonding ;
    atlas:sourceLocation "ch. 1, p. 5" ;
    atlas:verbatim "any ordering of a set is a relation defined on the set" .

case:klir-books-partitioned a atlas:Example ;
    rdfs:label "a collection of books, partitioned"@en ;
    atlas:encodedBy "Shingai Thornton (Claude-assisted)" ;
    atlas:encodedOn "2026-08-03"^^xsd:date ;
    atlas:evidenceCode atlas:HVP ;
    atlas:gloss "a collection of books partitioned by subject, publisher, or language" ;
    atlas:sourceLocation "ch. 1, p. 5" ;
    atlas:verbatim "every partition of a set emerges from a particular equivalence relation defined on the set" .

case:klir-population-by-birth a atlas:Example ;
    rdfs:label "a human population, ordered by dates of birth"@en ;
    rdfs:comment """The quotation licenses this case rather than describing it: Klir is making
a point about a RELATION being transferable to a different carrier set, and the human
population is his instance of it. A splice, recorded as one."""@en ;
    atlas:encodedBy "Shingai Thornton (Claude-assisted)" ;
    atlas:encodedOn "2026-08-03"^^xsd:date ;
    atlas:evidenceCode atlas:HVP ;
    atlas:gloss "a human population ordered by dates of birth" ;
    atlas:sourceLocation "ch. 1, p. 5" ;
    atlas:verbatim "may be applied not only to other sets of books, but also to sets whose elements are not books" .

prim:action a skos:Concept ;
    skos:inScheme atlas:PrimitiveScheme ;
    skos:prefLabel "action"@en ;
    skos:scopeNote "Bunge's acts-on relation, written x |> y."@en .

prim:bond a skos:Concept ;
    skos:inScheme atlas:PrimitiveScheme ;
    skos:prefLabel "bond"@en ;
    skos:scopeNote "A bonding relation, as opposed to a merely nonbonding one. Bunge requires the bonding set to be nonempty; this is the primitive that does the refusing."@en .

prim:composition a skos:Concept ;
    skos:inScheme atlas:PrimitiveScheme ;
    skos:prefLabel "composition"@en ;
    skos:scopeNote "Bunge's C. The set of a thing's parts, relativised to a class A and a time t."@en .

prim:measure a skos:Concept ;
    skos:inScheme atlas:PrimitiveScheme ;
    skos:prefLabel "measure"@en ;
    skos:scopeNote "Bertalanffy's Qᵢ, 'some measure of elements'. The word is his; reading Qᵢ as a state variable is an interpretation and stays out of the scheme."@en .

prim:part a skos:Concept ;
    skos:inScheme atlas:PrimitiveScheme ;
    skos:prefLabel "part"@en ;
    skos:scopeNote "Bunge's part-of relation, written x [ y."@en .

prim:structure a skos:Concept ;
    skos:inScheme atlas:PrimitiveScheme ;
    skos:prefLabel "structure"@en ;
    skos:scopeNote "Bunge's S. Relations among components and between components and environment, partitioned into bonding and nonbonding."@en .

prim:systemhood a skos:Concept ;
    skos:inScheme atlas:PrimitiveScheme ;
    skos:prefLabel "systemhood"@en ;
    skos:scopeNote "Klir's term, paired with thinghood."@en .

prim:thinghood a skos:Concept ;
    skos:inScheme atlas:PrimitiveScheme ;
    skos:prefLabel "thinghood"@en ;
    skos:scopeNote "Klir's term. Recorded as its own primitive rather than folded into `thing`, because whether it is distinct is a census question, not a modelling decision."@en .

prim:time a skos:Concept ;
    skos:inScheme atlas:PrimitiveScheme ;
    skos:prefLabel "time"@en ;
    skos:scopeNote "Bunge's triple is indexed at a time t. Klir's is not. A candidate point of divergence. In Bertalanffy's eq. (3.1) the invocation is notational — the t of dQᵢ/dt — rather than the word."@en .

cco:ont00000853 a owl:Class ;
    rdfs:label "Descriptive Information Content Entity"@en ;
    rdfs:subClassOf cco:ont00000958 ;
    skos:definition "An Information Content Entity that consists of a set of propositions that describe some Entity."@en .

cco:ont00000958 a owl:Class ;
    rdfs:label "Information Content Entity"@en ;
    rdfs:subClassOf obo:BFO_0000031 ;
    skos:definition "A Generically Dependent Continuant that generically depends on some Information Bearing Entity and stands in relation of aboutness to some Entity."@en .

obo:BFO_0000002 a owl:Class ;
    rdfs:label "continuant"@en ;
    rdfs:subClassOf obo:BFO_0000001 ;
    skos:definition "(Elucidation) A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity"@en .

skos:ConceptScheme a owl:Class ;
    rdfs:label "Concept Scheme"@en ;
    skos:definition "A set of concepts, optionally including statements about semantic relationships between those concepts."@en .

atlas:TestObject a owl:Class ;
    rdfs:label "Test Object"@en ;
    rdfs:comment """A TEST OBJECT IS ITSELF A CLAIM, and carries its own evidence code for that
reason. Asserting that two cases are about one object is an interpretation of both, made by
whoever draws the vocabulary — not something read off either source. Grading the object rather
than each link avoids a regress: the link inherits the identification's grade, and the
identification is argued in the mapping layer via atlas:arguedIn.

EXTERNAL AND PRIOR, like D1's candidate fix for the primitive scheme. A test object must be a
case an author actually ruled on, never one invented to make a comparison come out. If nothing
in the corpus rules on it, it does not belong here."""@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition """An object that definitions rule on, named once so that two authors ruling
on it can be identified as ruling on the SAME thing. Klir's "a collection of books ordered by
authors' names" and Bunge's "a collection of events, even if ordered" are two cases of one test
object; no string comparison will ever discover that."""@en .

bearer:bunge-1979-treatise-vol4 a cco:ont00000253 ;
    rdfs:label "Bunge, M. — Treatise on Basic Philosophy, Vol. 4: Ontology II — A World of Systems (Reidel, 1979)"@en ;
    dcterms:creator "Mario Bunge" ;
    dcterms:date "1979"^^xsd:gYear ;
    dcterms:identifier "doi:10.1007/978-94-009-9392-1" .

case:bunge-factory a atlas:Example ;
    rdfs:label "a factory"@en ;
